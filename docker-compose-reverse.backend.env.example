# Copy this file to docker-compose-reverse.backend.env.

NODE_ENV=production

# Keep this password aligned with POSTGRES_PASSWORD
# in docker-compose-reverse.postgres.env.
DATABASE_URL=postgres://emitmachine:change-this-password@postgres:5432/emitmachine

# Browser-facing HTTPS origin.
CORS_ORIGIN=https://your.domain.com
COOKIE_SECURE=true

# Passkeys/WebAuthn require these values to match the HTTPS domain
# opened in the browser.
RP_ID=your.domain.com
RP_ORIGIN=https://your.domain.com

# Generate a real value with:
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

LOG_LEVEL=info
LOG_FORMAT=json
